# Wren AI 版本配置
COMPOSE_PROJECT_NAME=wrenai
PLATFORM=linux/arm64
PROJECT_DIR=.

# 组件版本 (与官方 0.29.x 对齐)
WREN_PRODUCT_VERSION=0.29.1
WREN_ENGINE_VERSION=0.22.0
WREN_AI_SERVICE_VERSION=0.29.0
IBIS_SERVER_VERSION=0.22.0
WREN_UI_VERSION=0.32.2
WREN_BOOTSTRAP_VERSION=0.1.5

# 端口
WREN_ENGINE_PORT=8080
WREN_ENGINE_SQL_PORT=7432
WREN_AI_SERVICE_PORT=5555
IBIS_SERVER_PORT=8000
WREN_UI_PORT=3000
HOST_PORT=3000
AI_SERVICE_FORWARD_PORT=5555

# Ollama 虚拟 API Key (Ollama 不需要真实 key，但变量必须存在)
LLM_OLLAMA_API_KEY=ollama-dummy-key
EMBEDDER_OLLAMA_API_KEY=ollama-dummy-key
OPENAI_API_KEY=ollama-dummy-key

# LLM 模型
GENERATION_MODEL=qwen2.5:7b

# 遥测 (可关闭)
TELEMETRY_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
USER_UUID=

# 本地存储
LOCAL_STORAGE=.
SHOULD_FORCE_DEPLOY=1
